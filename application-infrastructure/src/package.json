{
	"name": "@63klabs/atlantis-mcp",
	"version": "0.0.1",
	"description": "The Atlantis MCP Server provides AI-assisted development capabilities for the 63Klabs Atlantis Templates and Scripts Platform, enabling developers to discover, validate, and utilize CloudFormation templates, starter code, and documentation through AI assistants and IDEs.",
	"author": "Chad Kluck",
	"main": "index.js",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"imports": {
		"#root/*.js": "./*.js"
	},
	"directories": {
		"test": "tests"
	},
	"scripts": {
		"test": "node --max-old-space-size=1024 --experimental-vm-modules ./node_modules/jest/bin/jest.js",
		"tests": "node --max-old-space-size=1024 --experimental-vm-modules ./node_modules/jest/bin/jest.js",
		"test:performance": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/performance/",
		"test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit/",
		"test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration/",
		"test:static": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns=test/static --no-coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"@63klabs/cache-data": "^1.3.10"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "3.x",
		"@aws-sdk/client-s3": "3.x",
		"@aws-sdk/client-ssm": "3.x",
		"@aws-sdk/lib-dynamodb": "3.x",
		"@jest/globals": "^30.2.0",
		"aws-sdk-client-mock": "^4.x",
		"eslint": "^10.0.2",
		"fast-check": "^4.5.3",
		"jest": "^30.3.0",
		"jest-environment-jsdom": "^30.3.0"
	}
}
