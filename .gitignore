# Ignore the git, ve, and zip files and directories
.*
# Track the per-function .npmrc (pins npm install behavior for the Lambda builds)
!application-infrastructure/src/lambda/*/.npmrc
*.zip
venv*
.venv*
.ve*

# Ignore program and OS files
.vscode
*.DS_Store
*desktop.ini

# If you need to remove .DS_Store
# find . -name .DS_Store -print0 | xargs -0 git rm -f --ignore-unmatch

# Ignore Generated
node_modules/
application-infrastructure/src/coverage/
__pycache__/
*.py[cod]
**/config/release-version.js

# Exceptions
!.gitignore
!.github
!.nvmrc
!.kiro
!.config.kiro

.kiro/settings
